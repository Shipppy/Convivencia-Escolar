# Copia este archivo como .env y completa los valores. NO subas .env a GitHub.
DATABASE_URL=postgresql://usuario:clave@epxxxx.neon.tech/neondb?sslmode=require
JWT_SECRET_KEY=cambia-esto-por-un-texto-largo-y-aleatorio
JWT_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
# Correo (opcional). Opcion A: Brevo por HTTPS (funciona en Render gratis)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Convivencia Escolar
# Opcion B: SMTP (Gmail, solo en local o Render de pago)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
